# Copy to .env only on a machine that runs the local decision server.
# Do not commit .env. GitHub Pages does not use these values.

# Optional local oMLX (OpenAI-compatible) endpoint.
OMLX_BASE_URL=http://127.0.0.1:8000/v1
OMLX_MODEL=

# Optional OpenAI fallback. Leave the key empty in git.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# Local decision server port. The Vite dev server proxies /api to this port.
PORT=3001
